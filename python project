# CONSOLE USER INTERFACE & INPUT VALIDATION
# -------------------------------------------------------------
def get_positive_int(prompt: str) -> int:
    """Prompt user for a positive integer with input validation."""
    while True:
        try:
            value = int(input(prompt).strip())
            if value <= 0:
                print("[Input Error] Value must be greater than zero. Try again.")
                continue
            return value
        except ValueError:
            print("[Input Error] Invalid input! Please enter a valid whole number.")


def get_positive_float(prompt: str) -> float:
    """Prompt user for a positive float with input validation."""
    while True:
        try:
            value = float(input(prompt).strip())
            if value <= 0:
                print("[Input Error] Rate must be greater than zero. Try again.")
                continue
            return value
        except ValueError:
            print("[Input Error] Invalid input! Please enter a valid decimal or numeric rate.")


def run_test_cases(system: RentalManagementSystem) -> None:
    """Automated runner for the 4 mandatory test cases."""
    print("\n" + "#" * 60)
    print("        RUNNING 4 MANDATORY SYSTEM TEST CASES         ")
    print("#" * 60)

    # Test Case 1: Add vehicle V1 (Car, Swift, 1500/day)
    print("\n--- [TEST CASE 1] Adding Vehicle V1 (Car, Swift, Rs. 1500/day) ---")
    system.add_vehicle(vehicle_id="V1", vehicle_type="Car", model="Swift", rate_per_day=1500.0)

    # Test Case 2: Rent V1 to customer 'Aman' for 7 days (10% discount -> Rs. 9450)
    print("\n--- [TEST CASE 2] Renting V1 to 'Aman' for 7 days (Expect 10% Discount, Rs. 9450) ---")
    record_aman = system.rent_vehicle(customer_name="Aman", vehicle_id="V1", days=7)
    if record_aman:
        assert record_aman.total_bill == 9450.0, f"Expected 9450.0, got {record_aman.total_bill}"
        print("-> Assertion Passed: Total Bill is exactly Rs. 9450.00")

    # Test Case 3: Attempt to rent the same V1 to 'Riya' for 2 days (Must fail)
    print("\n--- [TEST CASE 3] Attempt to rent V1 to 'Riya' for 2 days (Expect Blocked / Unavailable) ---")
    record_riya = system.rent_vehicle(customer_name="Riya", vehicle_id="V1", days=2)
    assert record_riya is None, "Test Failed: Vehicle V1 was rented when it was unavailable!"
    print("-> Assertion Passed: Blocked successfully with 'Vehicle V1 is not available'.")

    # Test Case 4: Rent V2 (Bike, Splendor, Rs. 500/day) to 'Neha' for 3 days (Rs. 1500), then return V2
    print("\n--- [TEST CASE 4] Rent V2 to 'Neha' for 3 days (Rs. 1500) and Return it ---")
    system.add_vehicle(vehicle_id="V2", vehicle_type="Bike", model="Splendor", rate_per_day=500.0)
    record_neha = system.rent_vehicle(customer_name="Neha", vehicle_id="V2", days=3)
    if record_neha:
        assert record_neha.total_bill == 1500.0, f"Expected 1500.0, got {record_neha.total_bill}"
        print("-> Assertion Passed: Total Bill for 3 days is Rs. 1500.00")

    print("\nReturning V2 back to inventory...")
    return_success = system.return_vehicle(vehicle_id="V2")
    assert return_success is True and system.vehicles["V2"].is_available is True
    print("-> Assertion Passed: V2 status restored to 'Available'.")

    print("\n" + "#" * 60)
    print("     ALL 4 TEST CASES EXECUTED & PASSED FLAWLESSLY!    ")
    print("#" * 60 + "\n")


def main() -> None:
    """Main interactive execution loop."""
    system = RentalManagementSystem(filename="vehicles.txt")

    while True:
        print("\n" + "=" * 48)
        print("     VEHICLE RENTAL MANAGEMENT SYSTEM (V1.0)     ")
        print("=" * 48)
        print(" 1. Add New Vehicle")
        print(" 2. Rent a Vehicle")
        print(" 3. Return a Vehicle")
        print(" 4. View All Vehicles (Inventory)")
        print(" 5. View Rental Transaction Logs")
        print(" 6. Run Automated Test Cases (Test Cases 1-4)")
        print(" 7. Exit System")
        print("=" * 48)

        choice = input("Enter your option (1-7): ").strip()

        if choice == "1":
            print("\n--- ADD NEW VEHICLE ---")
            v_id = input("Enter Vehicle ID (e.g., V1, V2): ").strip()
            if not v_id:
                print("[Input Error] Vehicle ID cannot be empty.")
                continue

            v_type = input("Enter Vehicle Type (Car / Bike / SUV): ").strip()
            v_model = input("Enter Vehicle Model (e.g., Swift, Splendor): ").strip()
            rate = get_positive_float("Enter Daily Rental Rate in Rs: ")

            system.add_vehicle(vehicle_id=v_id, vehicle_type=v_type, model=v_model, rate_per_day=rate)

        elif choice == "2":
            print("\n--- RENT A VEHICLE ---")
            customer = input("Enter Customer Name: ").strip()
            if not customer:
                print("[Input Error] Customer name cannot be empty.")
                continue

            v_id = input("Enter Vehicle ID to Rent: ").strip()
            days = get_positive_int("Enter Number of Rental Days: ")

            system.rent_vehicle(customer_name=customer, vehicle_id=v_id, days=days)

        elif choice == "3":
            print("\n--- RETURN A VEHICLE ---")
            v_id = input("Enter Vehicle ID to Return: ").strip()
            if not v_id:
                print("[Input Error] Vehicle ID cannot be empty.")
                continue

            system.return_vehicle(vehicle_id=v_id)

        elif choice == "4":
            system.display_all_vehicles()

        elif choice == "5":
            system.display_rental_logs()

        elif choice == "6":
            run_test_cases(system)

        elif choice == "7":
            system.save_vehicles_to_file()
            print("\n[Thank You] Inventory state saved to 'vehicles.txt'. Exiting system.")
            break

        else:
            print("\n[Invalid Selection] Please choose a valid option between 1 and 7.")


if __name__ == "__main__":
    main()